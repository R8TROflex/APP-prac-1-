# 4. DEMO / DRIVER CODE
# =====================================================================
if __name__ == "__main__":
    nums = [3, 34, 4, 12, 5, 2]
    target = 9

    print(f"Numbers: {nums}")
    print(f"Target sum: {target}\n")

    print(f"[1] Brute Force : {subset_sum_brute_force(nums, target)}")
    print(f"[2] Top-Down    : {subset_sum_top_down(nums, target)}")

    is_possible, dp = subset_sum_bottom_up(nums, target)
    print(f"[3] Bottom-Up   : {is_possible}")

    # ---- cross-check: all approaches agree ----
    assert subset_sum_brute_force(nums, target) == is_possible
    assert subset_sum_top_down(nums, target) == is_possible
    print("\n[check] All three approaches agree on the result.")
